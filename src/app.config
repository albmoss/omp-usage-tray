<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0"/>
  </startup>
  <runtime>
    <!-- Tiny heap, one UI thread: background GC would only add a thread and reserve memory. -->
    <gcConcurrent enabled="false"/>
    <!-- Skip Authenticode publisher evidence lookup at startup. -->
    <generatePublisherEvidence enabled="false"/>
  </runtime>
</configuration>
